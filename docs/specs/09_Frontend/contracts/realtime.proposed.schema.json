{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roadguard:realtime:proposed:v1",
  "title": "PROPOSED realtime invalidation hint; not implemented transport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "type",
    "occurredAt",
    "resource"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "notification.created",
        "task.changed",
        "policy.changed",
        "repair.changed",
        "job.changed",
        "file.verified",
        "access.changed"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "notification",
            "inspectionTask",
            "surveyTask",
            "repairItem",
            "repairAttempt",
            "policyVersion",
            "job",
            "file",
            "actor"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  },
  "$comment": "After validated hint, GET scoped resource. Never ACK sync or authorize from event. Resource type must match event semantics per doc06."
}
