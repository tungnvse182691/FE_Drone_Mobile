{
  "expo": {
    "name": "RoadGuard",
    "slug": "roadguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "roadguard",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hoanghai.roadguard",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "backgroundColor": "#FFFFFF", "imageWidth": 200, "resizeMode": "contain" }],
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-camera",
      "expo-location",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
